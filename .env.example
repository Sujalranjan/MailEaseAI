# Copy this file to backend/.env and fill in real values.
# Never commit the real .env file — it is already in .gitignore.

# --- Phase 1: required for the /emails endpoint ---
# For Gmail, EMAIL_APP_PASSWORD must be a Gmail "App Password"
# (Google Account > Security > App Passwords), never your account login
# password. Two such credentials were found hardcoded in the original
# prototype code during the audit and have been removed — if either was
# a real, still-active credential, rotate/revoke it in your Google
# Account before reusing this app.
EMAIL_ADDRESS=your_address@gmail.com
EMAIL_APP_PASSWORD=your_16_char_app_password
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993

# --- Later phases (not read by the app yet; documented for what's coming) ---
# DATABASE_URL=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
# LLM_API_KEY=
# SECRET_KEY=
